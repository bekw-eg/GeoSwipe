datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  username     String             @unique
  passwordHash String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  profile         Profile?
  progressState   UserProgressState?
  levelProgresses LevelProgress[]
  skillProgresses SkillProgress[]
  attemptRecords  AttemptRecord[]

  @@map("users")
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  displayName       String
  avatarUrl         String?
  preferredLanguage String   @default("ru")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserProgressState {
  id             String   @id @default(uuid())
  userId         String   @unique
  version        Int      @default(1)
  lastLevelId    String?
  unlockedLevels String[] @default([])
  activeHints    Json?
  reviewVariants Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress_states")
}

model LevelProgress {
  id                     String   @id @default(uuid())
  userId                 String
  levelId                String
  attempts               Int      @default(0)
  completions            Int      @default(0)
  assistedCompletions    Int      @default(0)
  independentCompletions Int      @default(0)
  independentReviews     Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, levelId])
  @@index([userId])
  @@index([levelId])
  @@map("level_progresses")
}

model SkillProgress {
  id          String    @id @default(uuid())
  userId      String
  skillId     String
  state       String    @default("notStudied")
  reviewStage Int       @default(0)
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@map("skill_progresses")
}

model AttemptRecord {
  id              String   @id @default(uuid())
  userId          String
  levelId         String
  topicId         String
  correct         Boolean
  hintCount       Int      @default(0)
  review          Boolean  @default(false)
  scheduledReview Boolean  @default(false)
  variant         Int      @default(0)
  answer          String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, levelId])
  @@index([userId, createdAt])
  @@map("attempt_records")
}
